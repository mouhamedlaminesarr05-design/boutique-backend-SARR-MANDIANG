        "/register": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Créer un compte (rôle employé ou gestionnaire uniquement)",
                "operationId": "5d4fa5d5607ed675ba93907e1fc94534",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "role"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Amadou Ba"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "amadou.ba@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "role": {
                                        "type": "string",
                                        "example": "employe",
                                        "enum": [
                                            "employe",
                                            "gestionnaire"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Compte créé, retourne l'utilisateur et son token"
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                }
            }
        },
