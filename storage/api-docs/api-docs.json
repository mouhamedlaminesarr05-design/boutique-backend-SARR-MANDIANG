            "post": {
                "tags": [
                    "Achats"
                ],
                "summary": "Enregistrer un nouvel achat pour un acheteur",
                "operationId": "e2054940650e1c24d1729ca475694081",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID de l'acheteur",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "produit_id",
                                    "quantite",
                                    "date_achat"
                                ],
                                "properties": {
                                    "produit_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "quantite": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "date_achat": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-07-28"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Achat enregistré"
                    },
                    "401": {
                        "description": "Non authentifié"
                    },
                    "404": {
                        "description": "Acheteur introuvable"
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
